# Parámetros NO sensibles del entorno local. Copiar a .env y ajustar.
# Nunca guardar aquí tokens, claves de desbloqueo ni contraseñas.
VAULT_VERSION=2.1.1
VAULT_CONTAINER_NAME=vpg-vault
VAULT_PORT_LOCAL=8200
VAULT_PORT_REMOTE=8200
VAULT_VOLUME_NAME=vpg-vault-data
VAULT_LOG_LEVEL=info
VAULT_UNSEAL_KEY=KeySecreto
VAULT_INITIAL_TOKEN=TokenSecreto
VAULT_ADMIN_USER_NAME=UsuarioAdmin
VAULT_ADMIN_USER_PASS=SecretoAdmin

# OIDC (opcional). Si faltan DISCOVERY_URL, CLIENT_ID o CLIENT_SECRET no se configura.
# Redirect URI a registrar en el proveedor: http://127.0.0.1:8200/ui/vault/auth/oidc/oidc/callback
VAULT_OIDC_DISCOVERY_URL=
VAULT_OIDC_CLIENT_ID=
VAULT_OIDC_CLIENT_SECRET=
VAULT_OIDC_USER_CLAIM=email
VAULT_OIDC_SCOPES=profile,email
VAULT_OIDC_POLICIES=vpg-oidc-user

DOCKER_NETWORK_NAME=network-service

# --- PostgreSQL 17 (parametros NO sensibles) ---------------------------------
# Las CONTRASENAS no van aqui: se suministran por Compose secrets
# (scripts/postgres/prepare-secrets.sh -> secrets/postgres_password y
#  secrets/postgres_app_password) y se leen con POSTGRES_PASSWORD_FILE.
POSTGRES_VERSION=17-alpine
POSTGRES_CONTAINER_NAME=vpg-postgres
POSTGRES_VOLUME_NAME=vpg-postgres-data
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_PORT_LOCAL=5432
POSTGRES_PORT_REMOTE=5432
POSTGRES_DB=vpg_contadores
# Cuenta administrativa y propietaria del esquema (la crea initdb).
POSTGRES_USER=vpg_admin
# Cuenta de ejecucion con permisos minimos para el futuro backend.
POSTGRES_APP_USER=vpg_app
POSTGRES_SCHEMA=employees
POSTGRES_INITDB_ARGS=--data-checksums

# --- Nombres de los recursos de Vault que consultan los scripts --------------
# Deben coincidir con los que crea scripts/vault-auth-bootstrap.sh.
VAULT_USERPASS_PATH=userpass
VAULT_MFA_METHOD_NAME=vpg-totp
VAULT_MFA_ENFORCEMENT=vpg-userpass-totp
