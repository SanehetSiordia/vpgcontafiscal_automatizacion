# Parámetros NO sensibles del entorno local. Copiar a .env y ajustar.
# Nunca guardar aquí tokens, claves de desbloqueo ni contraseñas.
VAULT_VERSION=2.1.1
VAULT_CONTAINER_NAME=vpg-vault
VAULT_PORT_LOCAL=8200
VAULT_PORT_REMOTE=8200
VAULT_VOLUME_NAME=vpg-vault-data
VAULT_LOG_LEVEL=info
VAULT_UNSEAL_KEY=KeySecreto
VAULT_INITIAL_TOKEN=TokenSecreto
VAULT_ADMIN_USER_NAME=UsuarioAdmin
VAULT_ADMIN_USER_PASS=SecretoAdmin

# OIDC (opcional). Si faltan DISCOVERY_URL, CLIENT_ID o CLIENT_SECRET no se configura.
# Redirect URI a registrar en el proveedor: http://127.0.0.1:8200/ui/vault/auth/oidc/oidc/callback
VAULT_OIDC_DISCOVERY_URL=
VAULT_OIDC_CLIENT_ID=
VAULT_OIDC_CLIENT_SECRET=
VAULT_OIDC_USER_CLAIM=email
VAULT_OIDC_SCOPES=profile,email
VAULT_OIDC_POLICIES=vpg-oidc-user

DOCKER_NETWORK_NAME=network-service

# --- PostgreSQL 17 (parametros NO sensibles) ---------------------------------
# Las CONTRASENAS no van aqui: se suministran por Compose secrets
# (scripts/postgres/prepare-secrets.sh -> secrets/postgres_password y
#  secrets/postgres_app_password) y se leen con POSTGRES_PASSWORD_FILE.
POSTGRES_VERSION=17-alpine
POSTGRES_CONTAINER_NAME=vpg-postgres
POSTGRES_VOLUME_NAME=vpg-postgres-data
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_PORT_LOCAL=5432
POSTGRES_PORT_REMOTE=5432
POSTGRES_DB=vpg_contadores
# Cuenta administrativa y propietaria del esquema (la crea initdb).
POSTGRES_USER=vpg_admin
# Cuenta de ejecucion con permisos minimos para el futuro backend.
POSTGRES_APP_USER=vpg_app
POSTGRES_SCHEMA=employees
POSTGRES_INITDB_ARGS=--data-checksums

# --- Nombres de los recursos de Vault que consultan los scripts --------------
# Deben coincidir con los que crea scripts/vault-auth-bootstrap.sh.
VAULT_USERPASS_PATH=userpass
VAULT_MFA_METHOD_NAME=vpg-totp
VAULT_MFA_ENFORCEMENT=vpg-userpass-totp

# --- user-mgmt-service / FastAPI (parametros NO sensibles) -------------------
# Las credenciales NO van aqui: contrasena de PostgreSQL y credenciales tecnicas
# de Vault (AppRole) se montan como Compose secrets desde secrets/.
PYTHON_VERSION=3.12-alpine
USER_MGMT_VERSION=0.3.0
USER_MGMT_CONTAINER_NAME=vpg-user-mgmt
USER_MGMT_HOST_BIND=127.0.0.1
USER_MGMT_PORT_LOCAL=8000
USER_MGMT_PORT_REMOTE=8000
USER_MGMT_ENVIRONMENT=local
USER_MGMT_LOG_LEVEL=info
USER_MGMT_API_PREFIX=/user_mgmt/v1
USER_MGMT_SESSION_TTL_SECONDS=3600
USER_MGMT_CHALLENGE_TTL_SECONDS=180
# Antiguedad maxima del MFA para operaciones destructivas (reset TOTP, purga).
USER_MGMT_SENSITIVE_OP_MFA_MAX_AGE_SECONDS=900
USER_MGMT_RATE_LIMIT_LOGIN_PER_MINUTE=10
USER_MGMT_RATE_LIMIT_MFA_PER_MINUTE=10
USER_MGMT_RATE_LIMIT_SESSION_PER_MINUTE=120

# Vault se publica solo en el loopback del host (el texto del README lo promete
# y sin este bind explicito Docker publicaria en 0.0.0.0).
VAULT_HOST_BIND=127.0.0.1

# --- vault-mgmt-service / etapa 4 (parametros NO sensibles) ------------------
# La credencial interna de la pasarela NO va aqui: se genera con
# scripts/vault_mgmt/prepare-internal-secret.sh y se monta como Compose secret
# desde secrets/vault_mgmt_internal_token.
VAULT_MGMT_VERSION=0.4.0
VAULT_MGMT_CONTAINER_NAME=vpg-vault-mgmt
VAULT_MGMT_HOST_BIND=127.0.0.1
VAULT_MGMT_PORT_LOCAL=8001
VAULT_MGMT_PORT_REMOTE=8001
VAULT_MGMT_ENVIRONMENT=local
VAULT_MGMT_LOG_LEVEL=info
VAULT_MGMT_API_PREFIX=/vault_mgmt/v1
# Esquema propio del catalogo. No es 'employees': ahi los permisos DML de
# vpg_app son mas amplios de lo que conviene para auditoria y esquemas.
VAULT_MGMT_POSTGRES_SCHEMA=vault_mgmt
# Montaje KV v2 y prefijo gestionado. Los segmentos data/metadata/delete/
# undelete/destroy son del cliente KV v2 y NO se configuran aqui.
VAULT_MGMT_KV_MOUNT=secret
VAULT_MGMT_KV_PREFIX=vpg-managed
# TTL del response wrapping con el que se entregan los valores (segundos).
VAULT_MGMT_WRAP_TTL_SECONDS=60
# Vida de la prueba breve de MFA reciente (segundos). La lee user-mgmt.
VAULT_MGMT_MFA_PROOF_TTL_SECONDS=300
# Topes de lote e inventario.
VAULT_MGMT_MAX_COLLECTION_BATCH=100
VAULT_MGMT_MAX_VERSIONS_PER_REQUEST=20
VAULT_MGMT_MAX_CRAWLER_RECORDS=20
VAULT_MGMT_MAX_RECORD_BYTES=65536
VAULT_MGMT_RATE_LIMIT_SESSION_PER_MINUTE=120
VAULT_MGMT_RATE_LIMIT_CONSUMER_PER_MINUTE=60
VAULT_MGMT_RATE_LIMIT_GLOBAL_PER_MINUTE=600

# --- Consumidor de maquina del futuro crawler --------------------------------
# role_id y secret_id NO van aqui: los crea y los muestra una sola vez
# scripts/vault_mgmt/crawler-approle-bootstrap.sh.
VAULT_CRAWLER_APPROLE_MOUNT=approle-crawler
VAULT_CRAWLER_ROLE_NAME=vpg-crawler
VAULT_CRAWLER_POLICY=vpg-crawler
VAULT_CRAWLER_CONSUMER_NAME=crawler-sat
