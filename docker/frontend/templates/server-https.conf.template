# -----------------------------------------------------------------------------
# Modo HTTPS (obligatorio con alcance 'lan', opcional en 'local').
#
# La aplicacion y la API se sirven UNICAMENTE por el servidor TLS. El servidor
# de texto claro que queda solo redirige, y no incluye app.conf: no sirve el
# login, no sirve estaticos y no reenvia la API. Una redireccion no protege
# unas credenciales que ya viajaron en claro, asi que lo unico razonable es que
# por ahi no haya nada que enviar.
#
# HSTS queda DESHABILITADO en esta fase, a proposito: es una politica que el
# navegador recuerda durante meses y que convertiria en inaccesible cualquier
# vuelta a HTTP en el mismo nombre. Activarla es una decision aparte, con su
# propio plazo y su propio nombre de dominio.
# -----------------------------------------------------------------------------

server {
  listen 127.0.0.1:${FRONTEND_HEALTH_PORT};
  server_name _;
  access_log off;

  location = /healthz {
    add_header Cache-Control "no-store" always;
    default_type application/json;
    return 200 '{"status":"ok","service":"frontend-service","mode":"https"}';
  }

  location / {
    return 404;
  }
}

# Redireccion al origen HTTPS configurado. El destino NO se construye con el
# Host de la peticion: se usa el valor validado del arranque, para que nadie
# pueda dirigir la redireccion con una cabecera.
server {
  listen ${FRONTEND_HTTP_PORT};
  server_name _;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Cache-Control "no-store" always;

  location / {
    return 308 ${VPG_HTTPS_BASE}$request_uri;
  }
}

server {
  listen ${FRONTEND_HTTPS_PORT} ssl;
  http2 on;
  server_name ${FRONTEND_PUBLIC_HOST};
  root /usr/share/nginx/html;
  index index.html;
  charset utf-8;

  ssl_certificate     /run/secrets/frontend_tls_cert;
  ssl_certificate_key /run/secrets/frontend_tls_key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_session_cache shared:vpgtls:1m;
  ssl_session_timeout 10m;
  ssl_session_tickets off;

  set $vpg_scheme "https";

  include /etc/nginx/vpg/snippets/app.conf;
}
